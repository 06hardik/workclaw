# ── Server ──
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── AI Verification ──
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# ── Blockchain (Mantle Sepolia) ──
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_CHAIN_ID=5003

# Agent wallet - the backend's own wallet that calls agentRelease/updateYield
AGENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
AGENT_WALLET_ADDRESS=
AGENT_NFT_ID=1

# Deployed contract addresses (filled automatically by contracts/scripts/deploy.js)
WORK_ESCROW_ADDRESS=
AGENT_LEDGER_ADDRESS=
MOCK_USDC_ADDRESS=

# ── Byreal (Solana CLMM Yield) ──
BYREAL_POOL_ID=ByRealUSDC_USDT_Demo_Pool
BYREAL_APY=18.3
# DEMO_MODE=true simulates Byreal yield in-memory without calling byreal-cli / Solana
DEMO_MODE=true

# ── Session ──
SESSION_SECRET=change_this_to_a_random_string

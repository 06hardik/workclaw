{
  "name": "workclaw-contracts",
  "version": "1.0.0",
  "description": "WorkClaw smart contracts - deployed on Mantle Sepolia",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.js --network mantle-sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mantle-mainnet",
    "deploy:local": "hardhat run scripts/deploy.js --network hardhat",
    "verify:testnet": "hardhat verify --network mantle-sepolia",
    "node": "hardhat node",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "dotenv": "^16.0.0",
    "hardhat": "^2.22.0"
  }
}
